{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "knd-agent",
        "namespace": "knd-system"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {
        "name": "knd-agent"
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "nodes",
            "pods"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "knd-agent"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "knd-agent"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "knd-agent",
          "namespace": "knd-system"
        }
      ]
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "knd-agent",
        "namespace": "knd-system",
        "labels": {
          "app": "knd-agent"
        }
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "knd-agent"
          }
        },
        "updateStrategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxUnavailable": 1
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "knd-agent"
            }
          },
          "spec": {
            "serviceAccountName": "knd-agent",
            "hostNetwork": true,
            "hostPID": true,
            "dnsPolicy": "Default",
            "terminationGracePeriodSeconds": 10,
            "tolerations": [
              {
                "operator": "Exists"
              }
            ],
            "initContainers": [
              {
                "name": "install-cni",
                "image": "docker.io/library/knd-agent:v0.3",
                "imagePullPolicy": "Never",
                "command": [
                  "sh",
                  "-ec",
                  "for name in knd-cni host-local loopback; do cp /opt/knd/cni/$name /host/cni/$name.new; chmod 0755 /host/cni/$name.new; mv /host/cni/$name.new /host/cni/$name; done"
                ],
                "volumeMounts": [
                  {
                    "name": "bin",
                    "mountPath": "/host/cni"
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "agent",
                "image": "docker.io/library/knd-agent:v0.3",
                "imagePullPolicy": "Never",
                "args": [
                  "-underlay",
                  "underlay0",
                  "-mode",
                  "vxlan-fast"
                ],
                "env": [
                  {
                    "name": "NODE_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  },
                  {
                    "name": "KUBERNETES_SERVICE_HOST",
                    "value": "192.168.77.11"
                  },
                  {
                    "name": "KUBERNETES_SERVICE_PORT",
                    "value": "6443"
                  }
                ],
                "securityContext": {
                  "privileged": true
                },
                "volumeMounts": [
                  {
                    "name": "bpf",
                    "mountPath": "/sys/fs/bpf"
                  },
                  {
                    "name": "state",
                    "mountPath": "/var/lib/knd"
                  },
                  {
                    "name": "ipam",
                    "mountPath": "/var/lib/cni/networks"
                  },
                  {
                    "name": "socket",
                    "mountPath": "/run/knd"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/cni/net.d"
                  },
                  {
                    "name": "netns",
                    "mountPath": "/var/run/netns",
                    "mountPropagation": "HostToContainer"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "kndctl",
                      "doctor"
                    ]
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "kndctl",
                      "doctor"
                    ]
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "bpf",
                "hostPath": {
                  "path": "/sys/fs/bpf",
                  "type": "Directory"
                }
              },
              {
                "name": "state",
                "hostPath": {
                  "path": "/var/lib/knd",
                  "type": "Directory"
                }
              },
              {
                "name": "ipam",
                "hostPath": {
                  "path": "/var/lib/cni/networks",
                  "type": "Directory"
                }
              },
              {
                "name": "socket",
                "hostPath": {
                  "path": "/run/knd",
                  "type": "DirectoryOrCreate"
                }
              },
              {
                "name": "config",
                "hostPath": {
                  "path": "/etc/cni/net.d",
                  "type": "Directory"
                }
              },
              {
                "name": "netns",
                "hostPath": {
                  "path": "/var/run/netns",
                  "type": "DirectoryOrCreate"
                }
              },
              {
                "name": "bin",
                "hostPath": {
                  "path": "/opt/cni/bin",
                  "type": "Directory"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
