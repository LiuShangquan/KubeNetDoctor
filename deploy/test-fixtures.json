    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "a",
        "namespace": "knd-test",
        "labels": {
          "knd-case": "a"
        }
      },
      "spec": {
        "nodeName": "knd-node1",
        "terminationGracePeriodSeconds": 2,
        "containers": [
          {
            "name": "tools",
            "image": "docker.io/library/knd-test:v0.1",
            "imagePullPolicy": "Never",
            "command": [
              "sh",
              "-ec",
              "mkdir -p /www; hostname > /www/index.html; python3 -m http.server 8080 --directory /www & socat UDP4-RECVFROM:8081,reuseaddr,fork EXEC:/bin/cat & iperf3 -s -p 5201 > /tmp/iperf.log 2>&1 & wait"
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 8080
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 2
            }
          }
        ]
      }
    },
